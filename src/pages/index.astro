---
import Base from '../layouts/Base.astro';
import Item from '../components/Item.astro';
import { items } from '../data/site';

const nav = items.filter((i) => i.nav);
---
<Base>
  <main class="items">
    {items.map((item, i) => <Item item={item} first={i === 0} nav={nav} />)}
  </main>
  <button class="swap" type="button" aria-label="Swap columns">⇄</button>
</Base>
