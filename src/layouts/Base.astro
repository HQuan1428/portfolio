---
import { site } from '../data/site';

const ogImage = new URL('og.png', site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={site.url} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site.url} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: light-dark(#fbfbfd, #0f1115);
    --fg: light-dark(#1b1d22, #e8e9ee);
    --muted: light-dark(#5a5f6b, #a0a5b2);
    --accent: light-dark(#3b4fe0, #8c9bff);
    --card: light-dark(#ffffff, #181b22);
    --border: light-dark(#e3e5ea, #2a2e38);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
  }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); }
  html { scroll-behavior: smooth; }
  a { color: var(--accent); transition: color 0.2s; }
  a:hover { color: var(--fg); }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  img { max-width: 100%; height: auto; display: block; }
  main > section {
    max-width: 52rem;
    margin-inline: auto;
    padding: 4rem 1rem;
    scroll-margin-top: 4rem;
  }
  h2 { font-size: 1.75rem; margin-block: 0 1.5rem; }

  /* Motion is progressive enhancement: without support or with reduced motion, content stays static and visible. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .reveal {
        animation: reveal linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
    }
    .hero-enter > * {
      animation: hero-in 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero-enter > :nth-child(2) { animation-delay: 0.12s; }
    .hero-enter > :nth-child(3) { animation-delay: 0.24s; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition: none !important; }
  }
  @keyframes reveal {
    from { opacity: 0; translate: 0 2rem; }
    to { opacity: 1; translate: 0 0; }
  }
  @keyframes hero-in {
    from { opacity: 0; translate: 0 1.5rem; scale: 0.97; }
    to { opacity: 1; translate: 0 0; scale: 1; }
  }
</style>
