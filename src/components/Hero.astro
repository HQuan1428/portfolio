---
import { Image } from 'astro:assets';
import { profile, techStack, education } from '../data/site';
import { asset } from '../lib/assets';
import Period from './Period.astro';
import * as icons from 'simple-icons';

type SimpleIcon = { path: string; hex: string };
const logo = (name: string) => (icons as unknown as Record<string, SimpleIcon>)[name];
// Black brand colours vanish on the dark background; use white on hover instead.
const brand = (name: string) => (logo(name).hex === '000000' ? 'fff' : logo(name).hex);
---
<section id="home" aria-labelledby="home-title">
  <div class="intro">
    <div class="text enter">
      <h1 id="home-title" lang="vi">{profile.name}</h1>
      <p class="role">{profile.role}</p>
      <p>{profile.intro}</p>
      <a class="cta" href="#contact">Get in touch <span aria-hidden="true">›</span></a>
    </div>
    <div id="education" class="edu enter" aria-labelledby="education-title">
      <p class="label">Education</p>
      <h2 id="education-title">{education.school}</h2>
      <dl>
        <div><dt>Graduated</dt><dd>{education.graduated}</dd></div>
      </dl>
      <p class="period"><Period start={education.start} end={education.end} /></p>
    </div>
    <Image class="avatar enter" src={asset(profile.avatar)} alt={profile.avatarAlt} width={460} height={460} format="webp" loading="eager" />
  </div>
  <div class="stack reveal">
    <h2>Tech stack</h2>
    <div class="marquee">
      {[false, true].map((copy) => (
        <ul aria-hidden={copy ? 'true' : undefined}>
          {techStack.map((t) => (
            <li title={t.name} style={t.icon ? `--brand: #${brand(t.icon)}` : undefined}>
              {t.icon && (
                <svg viewBox="0 0 24 24" width="56" height="56" aria-hidden="true"><path d={logo(t.icon).path} fill="currentColor" /></svg>
              )}
              {t.image && <Image src={asset(t.image)} alt="" aria-hidden="true" width={80} format="webp" loading="lazy" />}
              <span class="sr-only">{t.name}</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--nav-h));
    gap: 2rem;
    padding-block: clamp(2rem, 8vh, 5rem) 0;
  }
  .intro { display: grid; grid-template-columns: minmax(0, 32rem) auto 1fr; gap: 3rem; align-items: center; }
  .avatar { justify-self: end; }
  /* Education reads as a stats column bridging intro and avatar: no box, hairline dividers. */
  .edu {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.5rem 0 0.5rem 2rem;
    border-left: 1px solid var(--line);
  }
  .edu.enter { animation-delay: 0.08s; }
  .edu .label { margin: 0; color: var(--accent-hi); font-size: 0.85rem; }
  .edu h2 { font-size: 1.15rem; font-weight: 700; margin: 0; white-space: nowrap; }
  .edu dl { display: flex; flex-direction: column; gap: 1.25rem; margin: 0; }
  .edu dt { font-size: 0.8rem; }
  /* Raleway defaults to old-style figures (the 6 rises above the 2); use lining figures. */
  .edu dd { margin: 0; font: 800 1.75rem/1 var(--display); font-variant-numeric: lining-nums; color: var(--fg); }
  .edu .period { margin: 0; font-size: 0.85rem; }
  @media (max-width: 1100px) {
    .intro { grid-template-columns: 1fr auto; }
    /* Below the intro the column turns into a horizontal stats row. */
    .edu {
      grid-column: 1 / -1;
      width: auto;
      flex-flow: row wrap;
      align-items: flex-end;
      gap: 1rem 2.5rem;
      padding: 1.5rem 0;
      border-left: 0;
      border-block: 1px solid var(--line);
    }
    .edu .label, .edu h2 { flex-basis: 100%; }
    .edu dl { flex-direction: row; gap: 2.5rem; }
    .avatar { grid-column: 2; grid-row: 1; }
  }
  h1 { font-size: clamp(2.5rem, 6vw, 3rem); margin: 0; }
  .role { color: var(--accent-hi); margin: 0.25rem 0 1.5rem; }
  .text p:not(.role) { max-width: 30rem; }
  .cta {
    display: inline-flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding: 1.1rem 4rem;
    background: var(--accent);
    border: 1px solid var(--accent-hi);
    color: var(--on-accent);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 0 20px rgb(61 143 0 / 0.55);
    transition: box-shadow 0.2s, translate 0.2s;
  }
  .cta:hover { color: var(--on-accent); box-shadow: 0 0 32px rgb(61 143 0 / 0.85); translate: 0 -2px; }
  .avatar { width: min(460px, 32vw); aspect-ratio: 1; border-radius: 50%; object-fit: cover; }
  .stack h2 { font: 400 0.95rem var(--mono); color: var(--fg); margin: 0 0 1.25rem; }
  /* Stack fills the space under the intro and centres itself in it. */
  /* padding-bottom offsets the heading + section gap above the logos so the logo row itself is centred. */
  .stack { flex: 1; display: flex; flex-direction: column; justify-content: center; padding-bottom: 4.25rem; }
  /* Two identical lists slide left by one list width, looping seamlessly. */
  .marquee {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee ul { display: flex; flex-shrink: 0; gap: 4.5rem; margin: 0; padding: 0 2.25rem; list-style: none; animation: slide 40s linear infinite; }
  .marquee:is(:hover, :focus-within) ul { animation-play-state: paused; }
  .marquee li { display: grid; place-items: center; height: 80px; color: var(--muted); }
  .marquee svg { width: 56px; height: 56px; transition: color 0.2s; }
  .marquee img { height: 48px; width: auto; filter: grayscale(1) brightness(0.75); transition: filter 0.2s; }
  .marquee li:hover svg { color: var(--brand); }
  .marquee li:hover img { filter: none; }
  @keyframes slide { to { translate: -100% 0; } }
  @media (prefers-reduced-motion: reduce) {
    .marquee { mask-image: none; }
    .marquee ul { animation: none; flex-wrap: wrap; flex-shrink: 1; row-gap: 1.5rem; }
    .marquee ul[aria-hidden] { display: none; }
  }
  @media (max-width: 760px) {
    .intro { grid-template-columns: 1fr; }
    .edu { grid-column: auto; }
    .edu h2 { white-space: normal; }
    .avatar { order: -1; grid-column: auto; grid-row: auto; margin-inline: auto; width: min(240px, 60vw); }
    .cta { padding-inline: 2.5rem; }
  }
</style>
