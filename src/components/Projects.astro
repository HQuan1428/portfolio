---
import { Image } from 'astro:assets';
import { projects } from '../data/site';
import { asset } from '../lib/assets';
---
<section id="projects" class="reveal" aria-labelledby="projects-title">
  <h2 id="projects-title">Projects</h2>
  <ul class="grid">
    {projects.map((p) => (
      <li>
        <article class="card">
          <Image src={asset(`projects/${p.image}`)} alt={p.imageAlt} width={600} format="webp" loading="lazy" />
          <div class="body">
            <h3>{p.title}</h3>
            <p>{p.description}</p>
            <p class="tech">{p.tech.join(' · ')}</p>
            <p class="links">{p.links.map((l) => <a href={l.href}>{l.label}</a>)}</p>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); gap: 1.5rem; padding: 0; list-style: none; }
  .card {
    height: 100%;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: translate 0.2s, box-shadow 0.2s;
  }
  .card:hover, .card:focus-within { translate: 0 -4px; box-shadow: 0 10px 30px rgb(0 0 0 / 0.12); }
  .body { padding: 1rem 1.25rem 1.25rem; }
  h3 { margin: 0 0 0.5rem; }
  p { margin: 0 0 0.5rem; }
  .tech { color: var(--muted); font-size: 0.9rem; }
  .links { display: flex; gap: 1rem; margin: 0; }
</style>
