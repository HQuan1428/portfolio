---
import { Image } from 'astro:assets';
import type { Item } from '../data/site';
import { asset } from '../lib/assets';

interface Props {
  item: Item;
  first: boolean;
  nav: Item[];
}

const { item, first, nav } = Astro.props;
const Heading = first ? 'h1' : 'h2';
const detail = item.detail ?? [item.summary];
---
<article class="item" id={item.id} aria-labelledby={`${item.id}-title`}>
  <div class="detail">
    {item.image && (
      <Image
        class={first ? 'avatar' : 'shot'}
        src={asset(item.image)}
        alt={item.imageAlt ?? ''}
        width={first ? 160 : 600}
        format="webp"
        loading={first ? 'eager' : 'lazy'}
      />
    )}
    {detail.map((p) => <p>{p}</p>)}
    {item.tags && <ul class="tags">{item.tags.map((t) => <li>{t}</li>)}</ul>}
  </div>
  <div class="summary">
    {item.kicker && <p class="kicker">{item.kicker}</p>}
    <Heading id={`${item.id}-title`}>{item.title}</Heading>
    <p>{item.summary}</p>
    {item.links && <p class="links">{item.links.map((l) => <a href={l.href}>{l.label}</a>)}</p>}
    {first && (
      <nav aria-label="Sections">
        <ul>{nav.map((n) => <li><a href={`#${n.id}`}>{n.nav}</a></li>)}</ul>
      </nav>
    )}
  </div>
</article>

<style>
  .detail { background: var(--dark); color: var(--on-dark); padding: 1.5rem; }
  .summary { padding: 1.5rem 1.5rem 3rem; }
  .avatar { border-radius: 50%; }
  .shot { border-radius: 8px; }
  .detail img { margin-bottom: 1rem; }
  .detail p { margin: 0 0 1rem; }
  .kicker { margin: 0; font: 600 0.8rem/1.4 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  h1, h2 { font: 800 clamp(1.75rem, 4vw, 2.75rem)/1.1 var(--sans); margin: 0.25rem 0 0.75rem; }
  h1 { font-size: clamp(2.25rem, 6vw, 3.75rem); }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; list-style: none; font: 0.85rem var(--mono); }
  .tags li { padding: 0.15rem 0.6rem; border: 1px solid rgb(255 255 255 / 0.2); border-radius: 999px; }
  .links, nav ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; padding: 0; margin: 0; list-style: none; }
  nav { margin-top: 1.5rem; font-family: var(--sans); }
</style>
