---
import { skills } from '../data/site';
---
<section id="skills" aria-labelledby="skills-title">
  <h2 id="skills-title" class="reveal">Skills</h2>
  <ul class="groups">
    {skills.map((g) => (
      <li class="card reveal">
        <h3>{g.title}</h3>
        <ul class="points">{g.points.map((p) => <li>{p}</li>)}</ul>
        {g.tags && <ul class="tags">{g.tags.map((t) => <li>{t}</li>)}</ul>}
      </li>
    ))}
  </ul>
</section>

<style>
  .groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1.875rem; margin: 0; padding: 0; list-style: none; }
  h3 { margin: 0 0 1rem; }
  .points { margin: 0 0 1.25rem; padding-left: 1.1rem; }
  .points li + li { margin-top: 0.5rem; }
  .points li::marker { color: var(--accent-hi); }
</style>
